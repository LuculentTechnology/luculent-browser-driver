{
  "manifest_version": 3,
  "name": "Luculent Browser Driver for AI Agents",
  "version": "0.3.0",
  "description": "Let any AI agent drive Chrome via API/MCP \u2014 fast, secure, no reconnects. Killswitch, per-tab grants, password guard. Free.",
  "homepage_url": "https://luculent.dev/beta",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "downloads",
    "notifications",
    "webNavigation",
    "sidePanel",
    "tabGroups",
    "scripting",
    "offscreen"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Luculent Browser Driver for AI Agents",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "short_name": "Luculent Driver",
  "options_page": "options.html",
  "commands": {
    "killswitch": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Killswitch: stop all AI agents"
    },
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open the chat panel"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "externally_connectable": {
    "matches": [
      "https://luculent.dev/*",
      "https://www.luculent.dev/*",
      "https://luculent.app/*",
      "https://www.luculent.app/*"
    ]
  }
}
